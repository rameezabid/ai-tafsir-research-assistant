# Required
OPENAI_API_KEY=your_openai_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Model used for query generation and answers.
# You can change this to any OpenAI model your account supports.
OPENAI_MODEL=gpt-5.4-mini

# Public/private access control.
# false = only ALLOWED_TELEGRAM_USER_ID can use the bot.
# true  = anyone who can find/message the bot can use it.
PUBLIC_BOT=false

# Required only when PUBLIC_BOT=false.
# Run /id in your bot to get your Telegram user ID, then paste it here.
ALLOWED_TELEGRAM_USER_ID=123456789
